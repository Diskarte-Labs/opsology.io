# Microsoft Bookings scheduling URL (opens in centered popup)
NEXT_PUBLIC_BOOKING_URL=https://outlook.office.com/book/InitialConsultation@diskarte-group.com/?ismsaljsauthenabled

# Contact form verification: secret for signing 6-digit code tokens (min 16 chars).
CONTACT_VERIFY_SECRET=your-secret-at-least-16-characters

# Microsoft Graph mail (client credentials + Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the app sends as (must exist in the tenant)
GRAPH_SENDER_EMAIL=hello@opsology.io
# Where contact form submissions are delivered
CONTACT_INBOX_EMAIL=hello@opsology.io
